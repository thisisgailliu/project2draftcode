import os
import re
import glob
import subprocess
import pandas as pd
import numpy as np
import nltk

from collections import Counter
from nltk.corpus import stopwords, wordnet
from nltk.stem import WordNetLemmatizer
from nltk.tokenize import word_tokenize
from sklearn.feature_extraction.text import CountVectorizer, TfidfVectorizer
from sklearn.decomposition import LatentDirichletAllocation

nltk.download("punkt")
nltk.download("punkt_tab")
nltk.download("stopwords")
nltk.download("wordnet")
nltk.download("omw-1.4")

# Replace with your GitHub repository URL
repo_url = "https://github.com/YOUR_USERNAME/YOUR_REPOSITORY.git"

subprocess.run(
    ["git", "clone", repo_url, "novel_corpus"],
    check=True
)

files = sorted(glob.glob("novel_corpus/**/*.txt", recursive=True))

novels = []
titles = []

for file in files:
    with open(file, "r", encoding="utf-8-sig") as f:
        novels.append(f.read())
    titles.append(os.path.splitext(os.path.basename(file))[0])

print("Number of novels:", len(novels))
print("Titles:", titles)

assert len(novels) == 10, "Expected exactly 10 novels."




stop_words = set(stopwords.words("english"))
lemmatizer = WordNetLemmatizer()

def preprocess(text):
    text = text.lower()
    tokens = word_tokenize(text)

    tokens = [
        lemmatizer.lemmatize(word)
        for word in tokens
        if word.isalpha() and word not in stop_words
    ]

    return " ".join(tokens)

cleaned_novels = [preprocess(novel) for novel in novels]

df = pd.DataFrame({
    "title": titles,
    "text": novels,
    "cleaned_text": cleaned_novels
})

df.head()





for title, text in zip(titles, cleaned_novels):
    words = text.split()
    frequencies = Counter(words)

    print("\nNovel:", title)
    print(frequencies.most_common(20))





    tfidf_vectorizer = TfidfVectorizer(
    max_df=0.95,
    min_df=1,
    max_features=1000
)

tfidf_matrix = tfidf_vectorizer.fit_transform(cleaned_novels)

tfidf_df = pd.DataFrame(
    tfidf_matrix.toarray(),
    index=titles,
    columns=tfidf_vectorizer.get_feature_names_out()
)

display(tfidf_df)

tfidf_df.to_csv("novel_tfidf.csv")






count_vectorizer = CountVectorizer(
    max_df=0.95,
    min_df=1,
    max_features=2000
)

count_matrix = count_vectorizer.fit_transform(cleaned_novels)

lda = LatentDirichletAllocation(
    n_components=5,
    random_state=42,
    max_iter=20
)

lda_matrix = lda.fit_transform(count_matrix)

feature_names = count_vectorizer.get_feature_names_out()

for topic_idx, topic in enumerate(lda.components_):
    top_words = [
        feature_names[i]
        for i in topic.argsort()[-15:][::-1]
    ]

    print(f"Topic {topic_idx + 1}:")
    print(", ".join(top_words))
    print()

lda_df = pd.DataFrame(
    lda_matrix,
    index=titles,
    columns=[f"Topic {i+1}" for i in range(5)]
)

display(lda_df)

lda_df.to_csv("lda_topics_by_novel.csv")







from bertopic import BERTopic
from sentence_transformers import SentenceTransformer

embedding_model = SentenceTransformer("all-MiniLM-L6-v2")

topic_model = BERTopic(
    embedding_model=embedding_model,
    min_topic_size=2,
    verbose=True
)

# Use original texts for semantic embeddings
topics, probabilities = topic_model.fit_transform(novels)

topic_info = topic_model.get_topic_info()
display(topic_info)

document_info = topic_model.get_document_info(novels)
document_info["novel_title"] = titles

display(document_info[
    ["novel_title", "Topic", "Name"]
])

document_info.to_csv(
    "bertopic_novel_results.csv",
    index=False
)








topic_model.visualize_barchart()
