# 9. DIVIDE NOVELS INTO CHUNKS
def chunk_text(
    text,
    chunk_size=1200,
    overlap=100):

    words = text.split()

    chunks = []

    start = 0

    while start < len(words):

        end = start + chunk_size

        chunk = words[start:end]

        if len(chunk) >= 100:
            chunks.append(
                " ".join(chunk))

        start += chunk_size - overlap

    return chunks

