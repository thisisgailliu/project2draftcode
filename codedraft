# ================================================================
# 37. MIXED-EFFECTS MODEL
# ================================================================

# This is useful when the same author has written
# multiple works.
#
# The author becomes a random effect.


def run_mixed_model(
    dataframe,
    topic,
    numeric_predictors,
    categorical_predictors=None,
    group="author_id"
):

    if categorical_predictors is None:
        categorical_predictors = []


    predictors = []


    for variable in numeric_predictors:

        if variable in dataframe.columns:
            predictors.append(variable)


    for variable in categorical_predictors:

        if variable in dataframe.columns:

            predictors.append(
                f"C({variable})"
            )


    formula = (
        topic
        +
        " ~ "
        +
        " + ".join(predictors)
    )


    columns_needed = [

        topic,
        group

    ] + numeric_predictors + categorical_predictors


    columns_needed = [

        x
        for x in columns_needed
        if x in dataframe.columns
    ]


    df = (
        dataframe[
            columns_needed
        ]
        .dropna()
    )


    if (
        len(df) < 15
        or
        df[group].nunique() < 3
    ):

        print(
            "Not enough observations "
            "for mixed model."
        )

        return None


    try:

        model = smf.mixedlm(

            formula,

            data=df,

            groups=df[group]

        ).fit(
            reml=False
        )


        print(
            model.summary()
        )


        return model


    except Exception as e:

        print(
            "Mixed model failed:",
            e
        )

        return None


