def extract_lda_topics(
    model,
    feature_names,
    n_words=15
):

    rows = []

    for topic_number, topic in enumerate(
        model.components_
    ):

        top_indexes = (
            topic
            .argsort()[::-1][:n_words]
        )

        words = [
            feature_names[i]
            for i in top_indexes
        ]

        rows.append({

            "topic":
                topic_number,

            "top_words":
                ", ".join(words)
        })

    return pd.DataFrame(rows)


