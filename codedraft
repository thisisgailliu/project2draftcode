                "tfidf",

                TfidfVectorizer(

                    stop_words="english",

                    ngram_range=(1, 2),

                    min_df=2,

                    max_features=10000
                )
            ),

            (
                "classifier",

                LogisticRegression(

                    max_iter=2000,

                    class_weight="balanced",

                    random_state=RANDOM_STATE
                )
            )
        ])


        classifier.fit(
            X_train,
            y_train
        )


        predictions = (
            classifier.predict(
                X_test
            )
        )


        report = classification_report(

            y_test,

            predictions,

            zero_division=0
        )


        print(
            "\nSUPERVISED CLASSIFIER"
        )

        print(report)


        with open(

            OUTPUT_DIR /
            "classification_report.txt",

            "w"

        ) as f:

            f.write(report)


        labels = sorted(
            annotations["label"]
            .unique()
        )


        cm = confusion_matrix(

            y_test,

            predictions,

            labels=labels
        )


        cm_dataframe = pd.DataFrame(

            cm,

            index=[
                f"actual_{x}"
                for x in labels
            ],

            columns=[
                f"predicted_{x}"
                for x in labels
            ]
        )


        cm_dataframe.to_csv(

            OUTPUT_DIR /
            "confusion_matrix.csv"
        )


        joblib.dump(

            classifier,

            OUTPUT_DIR /
            "logistic_regression_classifier.joblib"
        )


