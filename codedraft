def run_topic_ols(
    dataframe,
    topic,
    numeric_predictors=None,
    categorical_predictors=None
):

    if numeric_predictors is None:
        numeric_predictors = []

    if categorical_predictors is None:
        categorical_predictors = []


    predictors = []


    for variable in numeric_predictors:

        if variable in dataframe.columns:
            predictors.append(variable)


    for variable in categorical_predictors:

        if variable in dataframe.columns:
            predictors.append(
                f"C({variable})"
            )


    if not predictors:

        print(
            "No valid predictors supplied."
        )

        return None


    formula = (
        topic
        +
        " ~ "
        +
        " + ".join(predictors)
    )


    print(
        "\nRegression formula:"
    )

    print(formula)


    needed = [
        topic
    ] + numeric_predictors + categorical_predictors


    needed = [
        col
        for col in needed
        if col in dataframe.columns
    ]


    regression_data = (

        dataframe[
            needed
        ]

        .dropna()
    )


    if len(regression_data) < 10:

        print(
            "Too few observations."
        )

        return None


    model = smf.ols(

        formula=formula,

        data=regression_data

    ).fit(
        cov_type="HC3"
    )


    print(
        model.summary()
    )


    return model


