# 10. TEXT CLEANING FOR LDA
def clean_for_lda(text):

    text = text.lower()

  # Keep alphabetic words and apostrophes.
    tokens = re.findall(
        r"\b[a-zA-Z][a-zA-Z']+\b",
        text)

    cleaned = []

    for token in tokens:

        if token in STOP_WORDS:
            continue

        if len(token) <= 2:
            continue

        lemma = lemmatizer.lemmatize(token)

        cleaned.append(lemma)

    return " ".join(cleaned)

